# Crisp plugin token (Crisp Marketplace > your plugin > Tokens). Needs scopes for:
# website:conversation:sessions (read), website:conversation:messages (read),
# website:operators (read), website:helpdesk (read), website:rating (read, if available)
CRISP_IDENTIFIER=
CRISP_KEY=
CRISP_WEBSITE_ID=622c4e0c-8d8a-4ccc-a152-2f83cbcae60d
CRISP_KB_LOCALE=en-us

# Claude API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high

PORT=3000
# Strongly recommended: chats contain customer data
DASHBOARD_PASSWORD=

# Optional automatic sync
SYNC_INTERVAL_MINUTES=0
SYNC_DAYS=2
SYNC_MAX_CONVERSATIONS=200
SYNC_CONCURRENCY=3
